# === Core ===
ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# === Database ===
# Local dev (Postgres en docker-compose o Postgres local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cobranzasegurossuda
# Para SQLite local rápido (sin docker):
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# === Superadmin (SIEMPRE desde env, NUNCA en DB) ===
SUPERADMIN_EMAIL=admin@voicenter.com.py
SUPERADMIN_NAME=Administrador Voicenter

# OPCIÓN A (simple, recomendada para Render): password en plano
SUPERADMIN_PASSWORD=CambiarEstaPassword123!

# OPCIÓN B (avanzada): hash bcrypt en lugar de plano (descomentar y dejar PASSWORD vacío)
# Generar con: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('TU_PASSWORD'))"
# SUPERADMIN_PASSWORD_HASH=$2b$12$...

# === JWT ===
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# === Storage ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# === Logs ===
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=365

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# === Branding ===
BRAND_PRIMARY_COLOR=#0066B3
BRAND_LOGO_PATH=/logo-voicenter-color.png

# === Agente de Experiencia (OpenAI Agents SDK) ===
# Sin OPENAI_API_KEY el agente queda visible pero responde "servidor sin API key".
# Requiere que la red de salida permita api.openai.com.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4
AGENT_REASONING_EFFORT=medium       # minimal | low | medium | high
AGENT_REASONING_SUMMARY=auto        # auto | detailed | (vacío para desactivar)
AGENT_MAX_HISTORY=20                # mensajes de contexto por conversación
AGENT_MAX_TOOL_TURNS=8              # iteraciones de tools por respuesta
